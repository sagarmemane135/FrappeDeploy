upstream frappe_web {
    server ${UPSTREAM_WEB} fail_timeout=0;
    keepalive 32;
}

upstream frappe_socketio {
    server ${UPSTREAM_SOCKETIO} fail_timeout=0;
    keepalive 16;
}

# Map for WebSocket Connection Header
map $$http_upgrade $$connection_upgrade {
    default upgrade;
    ''      close;
}

# HTTP Server Block
server {
    listen ${HTTP_PORT};
    server_name ${SERVER_NAME};

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};
    keepalive_timeout 65;

    root /home/frappe/frappe-bench/sites;

    # 1. Static Compiled Assets (Served directly from disk / shared volume)
    location /assets/ {
        alias /home/frappe/frappe-bench/sites/assets/;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # 2. Public Uploads (Dynamic site resolution based on Host)
    location ~ ^/files/(.*)$ {
        alias /home/frappe/frappe-bench/sites/$$host/public/files/$$1;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        try_files "" =404;
    }

    # 3. Private Uploads (Protected via X-Accel-Redirect)
    location /private/files/ {
        proxy_pass http://frappe_web;
        proxy_set_header Host $$host;
        proxy_set_header X-Use-X-Accel-Redirect v1;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
        proxy_set_header X-Frappe-Site-Name $$host;
    }

    # Protected internal file serving (triggered ONLY by X-Accel-Redirect response from Frappe)
    location ~ ^/protected/(.*)$ {
        internal;
        alias /home/frappe/frappe-bench/sites/$$host/$$1;
    }

    # 4. Socket.IO Real-time Events (WebSockets)
    location /socket.io/ {
        proxy_pass http://frappe_socketio;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $$http_upgrade;
        proxy_set_header Connection $$connection_upgrade;
        proxy_set_header Host $$host;
        proxy_set_header X-Frappe-Site-Name $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
        proxy_read_timeout ${PROXY_READ_TIMEOUT};
    }

    # 5. Core Frappe Python WSGI Application
    location / {
        proxy_pass http://frappe_web;
        proxy_redirect off;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
        proxy_set_header X-Frappe-Site-Name $$host;

        proxy_read_timeout ${PROXY_READ_TIMEOUT};
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}

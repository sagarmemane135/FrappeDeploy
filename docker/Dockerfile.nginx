# check=skip=SecretsUsedInArgOrEnv
FROM nginx:1.25-alpine

# Remove default configurations and templates
RUN rm -rf /etc/nginx/conf.d/* /etc/nginx/templates/*

# Copy master Nginx configuration
COPY nginx/nginx.conf /etc/nginx/nginx.conf

# Store templates in templates-available directory
RUN mkdir -p /etc/nginx/templates-available /etc/nginx/templates
COPY nginx/templates/default.conf.template /etc/nginx/templates-available/default.conf.template
COPY nginx/templates/default-ssl.conf.template /etc/nginx/templates-available/default-ssl.conf.template

# Dynamic template selector entrypoint
COPY nginx/docker-entrypoint.sh /docker-entrypoint-override.sh
RUN chmod +x /docker-entrypoint-override.sh

# Default environment variables (can be overridden at runtime)
ENV UPSTREAM_WEB="web:8000" \
    UPSTREAM_SOCKETIO="socketio:9000" \
    CLIENT_MAX_BODY_SIZE="50M" \
    PROXY_READ_TIMEOUT="120s" \
    HTTP_PORT="80" \
    HTTPS_PORT="443" \
    ENABLE_SSL="false" \
    SSL_CERT_PATH="/etc/ssl/certs/tls.crt" \
    SSL_KEY_PATH="/etc/ssl/certs/tls.key" \
    SERVER_NAME="_"

EXPOSE 80 443

ENTRYPOINT ["/docker-entrypoint-override.sh"]
CMD ["nginx", "-g", "daemon off;"]

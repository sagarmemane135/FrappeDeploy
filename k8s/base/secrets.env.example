# ==============================================================================
# Kubernetes Secret Environment Template (Use with sealed-secrets, vault, or kubectl)
# Create with: kubectl create secret generic frappe-secrets --from-env-file=secrets.env
# ==============================================================================

# Database Connection Details
FRAPPE_DB_HOST=mariadb.database.svc.cluster.local
FRAPPE_DB_PORT=3306
FRAPPE_DB_TYPE=mariadb
DB_ROOT_PASSWORD=StrongRootPasswordChangeMe!

# Optional Redis Auth Passwords (if use_redis_auth is enabled)
# REDIS_CACHE_PASSWORD=SecretRedisCachePass
# REDIS_QUEUE_PASSWORD=SecretRedisQueuePass

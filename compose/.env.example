# ==============================================================================
# Frappe Bench Deployment Configuration (.env)
# ==============================================================================

# Image Registry & Tag
FRAPPE_IMAGE=my-registry/frappe-app:v1.0.0
NGINX_IMAGE=my-registry/frappe-nginx:v1.0.0

# ------------------------------------------------------------------------------
# Database Configuration (MariaDB or PostgreSQL)
# ------------------------------------------------------------------------------
# If using external cloud database (AWS RDS, GCP CloudSQL, Azure MariaDB):
FRAPPE_DB_HOST=mariadb
FRAPPE_DB_PORT=3306
FRAPPE_DB_TYPE=mariadb
DB_ROOT_PASSWORD=RootSecretPasswordChangeMe123!

# MariaDB local container resource tuning (used in docker-compose.mariadb.yml)
MARIADB_BUFFER_POOL_SIZE=2G
MARIADB_MAX_CONNECTIONS=500

# ------------------------------------------------------------------------------
# Redis Topologies
# ------------------------------------------------------------------------------
FRAPPE_REDIS_CACHE=redis://redis-cache:6379
FRAPPE_REDIS_QUEUE=redis://redis-queue:6379

# Redis RAM allocation
REDIS_CACHE_MAXMEMORY=512mb
REDIS_QUEUE_MAXMEMORY=1gb

# ------------------------------------------------------------------------------
# Web & Worker Runtime Settings
# ------------------------------------------------------------------------------
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# Logging & Proxy Integration
FRAPPE_STREAM_LOGGING=1
USE_PROXY=1

# ------------------------------------------------------------------------------
# Nginx Proxy & SSL/TLS Configuration
# ------------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
CLIENT_MAX_BODY_SIZE=50M
PROXY_READ_TIMEOUT=120s

# Set to "true" if Nginx should terminate SSL directly
ENABLE_SSL=false
# Paths inside container if mounting custom certificates (PEM format)
SSL_CERT_PATH=/etc/ssl/certs/tls.crt
SSL_KEY_PATH=/etc/ssl/certs/tls.key
# Host path for certificates (mounted into Nginx)
HOST_SSL_CERTS_DIR=./certs

# ------------------------------------------------------------------------------
# Resource Limits (Docker Compose Deploy constraints)
# ------------------------------------------------------------------------------
WEB_CPU_LIMIT=2.0
WEB_MEM_LIMIT=2G
WORKER_DEFAULT_CPU_LIMIT=1.5
WORKER_DEFAULT_MEM_LIMIT=2G
WORKER_LONG_CPU_LIMIT=2.0
WORKER_LONG_MEM_LIMIT=4G
SCHEDULER_CPU_LIMIT=0.5
SCHEDULER_MEM_LIMIT=512M
